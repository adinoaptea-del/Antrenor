{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run prompts && npm run build -w apps/web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": { "api/**/*.ts": { "runtime": "nodejs20.x", "maxDuration": 120 } },
  "crons": [
    { "path": "/api/cron/sync", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/morning", "schedule": "30 2 * * *" },
    { "path": "/api/cron/evening", "schedule": "0 18 * * *" }
  ],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
