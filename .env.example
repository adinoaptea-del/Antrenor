# ---- Server (Vercel → Settings → Environment Variables; toate în Production și Preview) ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # Project Settings → API → anon public
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # Project Settings → API → service_role (secret: doar pe server)
APP_URL=https://antrenor.vercel.app # domeniul aplicației, fără slash la final
OAUTH_STATE_SECRET=                 # orice șir lung aleator (openssl rand -hex 32)
CRON_SECRET=                        # alt șir lung aleator; Vercel îl trimite la cron-uri
ANTHROPIC_API_KEY=sk-ant-...        # cheia modelului pentru agenți
MODEL_SPECIALIST=claude-sonnet-5-5
MODEL_HEAD=claude-opus-5-5          # același implicit ca în cod (server/_lib/env.ts)
AI_MANUAL_PER_DAY=6                 # rulări AI cerute din aplicație, pe sportiv și zi (auditul consolidat, B3)

# ---- Brățări (din aplicațiile create la producători; vezi docs/integrari.md) ----
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=                # orice șir; se folosește la crearea abonamentului webhook Strava
STRAVA_SUBSCRIPTION_ID=             # opțional: id-ul abonamentului webhook; setat, evenimentele de pe alt abonament se refuză
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# ---- Aplicația (variabile Vite, intră în bundle; publice) ----
# (nu mai sunt necesare: aplicația ia cheile de la /api/config)
# VITE_DEMO=1  → doar pentru pagina de previzualizare cu date demo; nu seta în producție
